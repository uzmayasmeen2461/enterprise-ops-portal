# =============================================================================
# Enterprise Ops Portal — Backend API Gateway
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# The AI provider base URL.
# For OpenAI: https://api.openai.com/v1
# For other OpenAI-compatible providers, replace with their base URL.
AI_BASE_URL=https://api.openai.com/v1

# Your AI provider API key.
# Get one at: https://platform.openai.com/api-keys
AI_API_KEY=your-api-key-here

# The model to use.
# Recommended: gpt-4o-mini (fast, cheap, excellent at structured output)
# Alternatives: gpt-4o, gpt-3.5-turbo
AI_MODEL=gpt-4o-mini

# Port this Express server listens on.
PORT=4000

# Your deployed frontend URL — used by CORS in production.
# Leave blank for local development (localhost:4200 is always allowed).
# Example: https://your-app.vercel.app
FRONTEND_URL=
